{
  "name": "digital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "dev:full": "concurrently -k \"npm run dev\" \"npm run dev:api\"",
    "build": "tsc -b && vite build",
    "start:api": "npm --prefix server run start",
    "preview": "vite preview",
    "preview:full": "concurrently -k \"npm run preview\" \"npm run start:api\"",
    "lint": "eslint .",
    "validate": "npm run build",
    "images:download": "node scripts/download-software-images-unsplash.mjs",
    "postinstall": "npm --prefix server install"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
