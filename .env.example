# DigitalManager — environment template
# Copy to `.env.local` for local development (never commit `.env.local`).

# ── Database (reserved / optional Prisma) ─────────────────────────────────────
# CMS content is stored in server/data/*.json by default.
# Set DATABASE_URL only if you add Prisma or another database layer.
DATABASE_URL="file:./dev.db"

# ── Admin auth / sessions ───────────────────────────────────────────────────
# Used to sign admin JWT tokens (AUTH_SECRET or legacy JWT_SECRET).
AUTH_SECRET="change-this-to-a-long-random-secret"
JWT_SECRET="change-this-to-a-long-random-secret"

# Allow `npm run db:seed:admin` to create the default local admin user.
ALLOW_ADMIN_BOOTSTRAP=true

# ── API server ────────────────────────────────────────────────────────────────
# Express CMS API port (default 3040). Not the Vite frontend port.
PORT=3040

# Pakistan market (pakistan-version branch)
MARKET=PK
CMS_DATA_DIR=data-pk
PUBLIC_SITE_URL=https://digitalmanager.com.pk

# Optional: enables `/?test_country=QA&test_key=...` geo override (UAE branch only).
# LOCALE_TEST_COUNTRY_KEY=your-long-random-test-secret

# ── Frontend CMS API URL ──────────────────────────────────────────────────────
# Leave empty for same-origin production (recommended).
# Set only when the frontend is hosted on a different origin than the API.
# NEVER set to localhost in production — the build will ignore it.
NEXT_PUBLIC_CMS_API_URL=
VITE_API_URL=

# Optional: Vite dev proxy target when API runs on a non-default port
# VITE_DEV_API_PORT=3041

# Serve the Vite build from ../dist (single-process production hosting).
# In NODE_ENV=production this defaults to on when dist/index.html exists.
# Set SERVE_STATIC=false to keep the API-only process.
# SERVE_STATIC=true

# ── SMTP (Pakistan inquiry emails — server-side only) ─────────────────────────
# Configure in Coolify Environment Variables for production. Never use VITE_* for these.
# Port 587 uses STARTTLS (keep SMTP_SECURE=false). Use SMTP_SECURE=true only for port 465.
# Pakistan branch password variable is SMTP_PASS (SMTP_PASSWORD also accepted as fallback).
SMTP_HOST=mail.digitalmanager.ae
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@digitalmanager.ae
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@digitalmanager.ae
SMTP_FROM_NAME=DigitalManager Pakistan
CONTACT_RECEIVER_EMAIL=sales@digitalsofts.com
