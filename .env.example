# ── Express API (server/) ─────────────────────────────────────────────────────
# Copy to .env in the project root (or server/.env) and adjust values.

# API listen port (default: 3040)
PORT=3040

# Required in production — used to sign admin JWT tokens
JWT_SECRET=change-me-to-a-long-random-string

# Serve the Vite build from ../dist (single-process production hosting)
# SERVE_STATIC=true

# ── SMTP (optional — lead notification emails) ────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Vite frontend (build-time only) ───────────────────────────────────────────
# Leave empty for local dev (Vite proxies /api and /uploads to the API).
# Set to your public API origin when the frontend is hosted separately.
# VITE_API_URL=https://api.example.com
